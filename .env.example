# =============================================================================
# Stock Research Multi-Agent System — Environment Variables
# Copy to .env and fill in values. Never commit .env.
# =============================================================================

# --- App ---
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# --- Redis (job status + optional LangGraph checkpointing) ---
REDIS_URL=redis://localhost:6379/0

# --- LLM Provider ---
# Options: openrouter | ollama | openai | anthropic
LLM_PROVIDER=openrouter
# OpenRouter free tier (no cost, needs account) — https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Any ":free" model works; see https://openrouter.ai/collections/free-models
OPENROUTER_MODEL=openai/gpt-oss-20b:free
# Ollama (local, only if LLM_PROVIDER=ollama)
LLM_MODEL=olmo-3:latest
OLLAMA_BASE_URL=http://localhost:11434
# OpenAI (swap for polished demo)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Anthropic (optional alternative)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-latest

# --- Data Sources ---
# yfinance: no key required

# News search — Tavily free tier (https://tavily.com)
TAVILY_API_KEY=

# Optional: Alpha Vantage fallback for market data
ALPHA_VANTAGE_API_KEY=

# --- Agent Runtime ---
MAX_CRITIC_RETRIES=2
# Whole-job hard cap; job marked failed after this
PIPELINE_TIMEOUT_SECONDS=420
# Cap LLM output tokens per call
LLM_NUM_PREDICT=350
# Max news articles sent through the LLM
NEWS_MAX_ARTICLES=5
BRIEF_CACHE_TTL_SECONDS=3600

# --- Advanced search (typeahead) ---
# Cached per query; the NSE catalog behind it only changes on a listing/rename
SEARCH_CACHE_TTL_SECONDS=21600
# Let an LLM interpret descriptive queries ("who makes maggi") when the lexical
# layers score poorly. Set false to run search fully offline/keyless.
SEARCH_LLM_FALLBACK=true
SEARCH_LLM_TIMEOUT_SECONDS=8

# --- Frontend (Vite + React) ---
VITE_API_URL=http://localhost:8000
